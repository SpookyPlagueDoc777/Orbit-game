; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Orbit Game"
run/main_scene="uid://dadfgw5isc1c8"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="uid://cpwnqagwse588"

[autoload]

Global="*uid://dbaqj2vikhhb0"
SaveManager="*uid://cgq7ersyw5sq6"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
mouse_cursor/custom_image="uid://dod4dblwd24fv"

[file_customization]

folder_colors={
"res://Audio/": "red",
"res://Code/": "blue",
"res://Scenes/": "purple",
"res://Textures/": "green"
}

[global_group]

satellites=""
satellites_container=""

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.008447852, 0.002413542, 0.03631795, 1)
